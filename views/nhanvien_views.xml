<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="nhanvien_view_list" model="ir.ui.view">
    <field name="name">nhanvien.view.list</field>
    <field name="model">nhanvien</field>
    <field name="arch" type="xml">
      <list string="Danh sách nhân viên" decoration-muted="state == 'nghi_viec'">
        <field name="empid"/>
        <field name="name"/>
        <field name="gender"/>
        <field name="phong_id"/>
        <field name="chucvu_id"/>
        <field name="phone"/>
        <field name="email" optional="hide"/>
        <field name="ngay_vao_lam" optional="hide"/>
        <field name="state" widget="badge"
               decoration-info="state == 'thu_viec'"
               decoration-success="state == 'chinh_thuc'"
               decoration-danger="state == 'nghi_viec'"/>
      </list>
    </field>
  </record>

  <record id="nhanvien_view_form" model="ir.ui.view">
    <field name="name">nhanvien.view.form</field>
    <field name="model">nhanvien</field>
    <field name="arch" type="xml">
      <form string="Chi tiết nhân viên">
        <header>
          <button name="action_chinh_thuc" type="object" string="Chuyển chính thức" class="btn-primary"
                  invisible="state != 'thu_viec'"/>
          <button name="action_nghi_viec" type="object" string="Cho nghỉ việc"
                  invisible="state == 'nghi_viec'"
                  confirm="Xác nhận cho nhân viên này nghỉ việc?"/>
          <button name="action_quay_lai_lam_viec" type="object" string="Quay lại làm việc"
                  invisible="state != 'nghi_viec'"/>
          <field name="state" widget="statusbar" statusbar_visible="thu_viec,chinh_thuc,nghi_viec"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_hopdong" type="object" class="oe_stat_button" icon="fa-file-text-o"
                    groups="kiemtra3.group_nhansu_user">
              <field name="hopdong_count" widget="statinfo" string="Hợp đồng"/>
            </button>
          </div>
          <widget name="web_ribbon" title="Lưu trữ" bg_color="text-bg-danger" invisible="active"/>
          <field name="image_1920" widget="image" class="oe_avatar"/>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="Họ và tên"/></h1>
            <h3>Mã NV: <field name="empid" class="oe_inline"/></h3>
          </div>
          <group>
            <group string="Thông tin cá nhân">
              <field name="gender"/>
              <field name="birthday"/>
              <field name="age"/>
              <field name="cccd" groups="kiemtra3.group_nhansu_user"/>
              <field name="phone" widget="phone"/>
              <field name="email" widget="email"/>
              <field name="address"/>
            </group>
            <group string="Công việc">
              <field name="phong_id"/>
              <field name="chucvu_id"/>
              <field name="ngay_vao_lam"/>
              <field name="ngay_nghi_viec" invisible="state != 'nghi_viec'"/>
              <field name="nam_cong_tac"/>
              <field name="luong_co_ban" groups="kiemtra3.group_nhansu_user"/>
              <field name="currency_id" invisible="1"/>
              <field name="company_id" groups="base.group_multi_company"/>
              <field name="active" invisible="1"/>
            </group>
          </group>
          <notebook>
            <page string="Hợp đồng" name="hopdong" groups="kiemtra3.group_nhansu_user">
              <field name="hopdong_ids" readonly="1">
                <list>
                  <field name="name"/>
                  <field name="loai"/>
                  <field name="ngay_bat_dau"/>
                  <field name="ngay_ket_thuc"/>
                  <field name="luong"/>
                  <field name="state" widget="badge"/>
                </list>
              </field>
            </page>
            <page string="Ghi chú" name="note">
              <field name="note"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="nhanvien_view_kanban" model="ir.ui.view">
    <field name="name">nhanvien.view.kanban</field>
    <field name="model">nhanvien</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_mobile" default_group_by="phong_id">
        <field name="id"/>
        <field name="state"/>
        <templates>
          <t t-name="card">
            <div class="d-flex">
              <field name="image_1920" widget="image" options="{'preview_image': 'image_1920'}"
                     class="o_kanban_image me-3" style="width:64px;height:64px"/>
              <div>
                <strong><field name="name"/></strong>
                <div class="text-muted"><field name="chucvu_id"/></div>
                <div><i class="fa fa-phone me-1" title="Điện thoại"/><field name="phone"/></div>
                <field name="state" widget="badge"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="nhanvien_view_search" model="ir.ui.view">
    <field name="name">nhanvien.view.search</field>
    <field name="model">nhanvien</field>
    <field name="arch" type="xml">
      <search string="Tìm nhân viên">
        <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('empid', 'ilike', self), ('phone', 'ilike', self)]"
               string="Tên / Mã / SĐT"/>
        <field name="phong_id"/>
        <field name="chucvu_id"/>
        <separator/>
        <filter name="thu_viec" string="Thử việc" domain="[('state', '=', 'thu_viec')]"/>
        <filter name="chinh_thuc" string="Chính thức" domain="[('state', '=', 'chinh_thuc')]"/>
        <filter name="nghi_viec" string="Đã nghỉ việc" domain="[('state', '=', 'nghi_viec')]"/>
        <separator/>
        <filter name="nam" string="Nam" domain="[('gender', '=', 'nam')]"/>
        <filter name="nu" string="Nữ" domain="[('gender', '=', 'nu')]"/>
        <filter name="archived" string="Đã lưu trữ" domain="[('active', '=', False)]"/>
        <group expand="0" string="Nhóm theo">
          <filter name="group_phong" string="Phòng" context="{'group_by': 'phong_id'}"/>
          <filter name="group_chucvu" string="Chức vụ" context="{'group_by': 'chucvu_id'}"/>
          <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
          <filter name="group_gender" string="Giới tính" context="{'group_by': 'gender'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="nhanvien_view_pivot" model="ir.ui.view">
    <field name="name">nhanvien.view.pivot</field>
    <field name="model">nhanvien</field>
    <field name="arch" type="xml">
      <pivot string="Thống kê nhân viên">
        <field name="phong_id" type="row"/>
        <field name="state" type="col"/>
      </pivot>
    </field>
  </record>

  <record id="nhanvien_view_graph" model="ir.ui.view">
    <field name="name">nhanvien.view.graph</field>
    <field name="model">nhanvien</field>
    <field name="arch" type="xml">
      <graph string="Nhân viên theo phòng" type="bar">
        <field name="phong_id"/>
      </graph>
    </field>
  </record>

  <record id="nhanvien_action_window" model="ir.actions.act_window">
    <field name="name">Quản lý nhân viên</field>
    <field name="res_model">nhanvien</field>
    <field name="view_mode">list,kanban,form,pivot,graph</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Tạo nhân viên đầu tiên</p>
    </field>
  </record>
</odoo>
