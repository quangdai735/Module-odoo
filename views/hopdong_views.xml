<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="hopdong_view_list" model="ir.ui.view">
    <field name="name">hopdong.view.list</field>
    <field name="model">hopdong</field>
    <field name="arch" type="xml">
      <list string="Hợp đồng lao động">
        <field name="name"/>
        <field name="nhanvien_id"/>
        <field name="phong_id" optional="show"/>
        <field name="loai"/>
        <field name="ngay_bat_dau"/>
        <field name="ngay_ket_thuc"/>
        <field name="luong"/>
        <field name="currency_id" column_invisible="True"/>
        <field name="state" widget="badge"
               decoration-info="state == 'nhap'"
               decoration-success="state == 'hieu_luc'"
               decoration-warning="state == 'het_han'"
               decoration-danger="state == 'huy'"/>
      </list>
    </field>
  </record>

  <record id="hopdong_view_form" model="ir.ui.view">
    <field name="name">hopdong.view.form</field>
    <field name="model">hopdong</field>
    <field name="arch" type="xml">
      <form string="Hợp đồng lao động">
        <header>
          <button name="action_xac_nhan" type="object" string="Xác nhận" class="btn-primary"
                  invisible="state != 'nhap'"/>
          <button name="action_het_han" type="object" string="Đánh dấu hết hạn" invisible="state != 'hieu_luc'"/>
          <button name="action_huy" type="object" string="Huỷ" invisible="state in ('huy', 'het_han')"/>
          <button name="action_ve_nhap" type="object" string="Về nháp" invisible="state not in ('huy', 'het_han')"/>
          <field name="state" widget="statusbar" statusbar_visible="nhap,hieu_luc,het_han"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="nhanvien_id" readonly="state != 'nhap'"/>
              <field name="phong_id"/>
              <field name="loai" readonly="state != 'nhap'"/>
            </group>
            <group>
              <field name="ngay_bat_dau" readonly="state != 'nhap'"/>
              <field name="ngay_ket_thuc" readonly="state != 'nhap'" required="loai != 'khong_xac_dinh'"/>
              <field name="luong" readonly="state != 'nhap'"/>
              <field name="currency_id" invisible="1"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
          </group>
          <field name="note" placeholder="Ghi chú..."/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="hopdong_view_search" model="ir.ui.view">
    <field name="name">hopdong.view.search</field>
    <field name="model">hopdong</field>
    <field name="arch" type="xml">
      <search string="Tìm hợp đồng">
        <field name="name"/>
        <field name="nhanvien_id"/>
        <field name="phong_id"/>
        <filter name="hieu_luc" string="Đang hiệu lực" domain="[('state', '=', 'hieu_luc')]"/>
        <filter name="het_han" string="Hết hạn" domain="[('state', '=', 'het_han')]"/>
        <filter name="sap_het_han" string="Sắp hết hạn (30 ngày)"
                domain="[('state', '=', 'hieu_luc'), ('ngay_ket_thuc', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
        <group expand="0" string="Nhóm theo">
          <filter name="group_nv" string="Nhân viên" context="{'group_by': 'nhanvien_id'}"/>
          <filter name="group_loai" string="Loại" context="{'group_by': 'loai'}"/>
          <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="hopdong_action_window" model="ir.actions.act_window">
    <field name="name">Hợp đồng lao động</field>
    <field name="res_model">hopdong</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
